# Variables for deploy/docker-compose.coolify.yml. Real values live in Coolify (never in git).
#
# 1. Secrets. On Coolify you do NOT set these: Coolify generates each SERVICE_... variable on the first deployment and keeps it.
#    Copy SERVICE_REALBASE64_ENCRYPTION and SERVICE_PASSWORD_64_BACKUP into a password manager and never change them.
#    Only when running the compose file outside Coolify do you fill them in yourself:
SERVICE_PASSWORD_POSTGRES=                  # database password
SERVICE_PASSWORD_64_PROXY=                  # >= 32 chars; shared by the ui and api containers
SERVICE_PASSWORD_64_CSRF=                   # >= 32 chars
SERVICE_PASSWORD_64_PEPPER=                 # >= 32 chars; changing it later invalidates every password
SERVICE_REALBASE64_ENCRYPTION=              # openssl rand -base64 32; losing it loses salaries, NIK, NPWP and bank accounts
SERVICE_PASSWORD_64_BACKUP=                 # encrypts every dump (*.dump.enc); without it no backup can be restored
SERVICE_PASSWORD_64_METRICS=                # >= 24 chars; bearer token for /health/metrics (Prometheus)
#
# 2. Settings you do set (on Coolify: Environment Variables of the resource).
API_ORIGIN=https://hris.annabadigital.io   # exact public origin of the UI, https, no trailing slash
API_AUTOMIGRATE=true                        # first start, ONE instance only (migrates and seeds roles/permissions)
BOOTSTRAP_ADMIN_EMAIL=                      # first super admin gets an invitation here while the database has no users
# E-mail. EMAIL_PROVIDER is 'smtp' (any SMTP server, no third-party account needed) or 'resend'.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com                     # relay host, or your own Postfix
SMTP_PORT=587                               # 587 with starttls, 465 with ssl
SMTP_SECURITY=starttls                      # starttls | ssl  ('none' is refused in Production)
SMTP_USERNAME=                              # e.g. your Gmail address. The API refuses to start with a username but no password
SMTP_PASSWORD=                              # e.g. a Google App Password (never your real password)
RESEND_API_KEY=                             # only when EMAIL_PROVIDER=resend
EMAIL_FROM=Annaba HR <no-reply@your-verified-domain>   # Gmail relay: Gmail sends as your own address whatever is written here; Resend: a verified domain
# Single sign-on (optional). Any OpenID Connect provider; leave blank to keep SSO off. Redirect URI to register at the provider: <your origin>/api/auth/sso/callback
SSO_ISSUER=                                 # e.g. https://accounts.google.com  or  https://login.microsoftonline.com/<tenant-id>/v2.0
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_DISPLAY_NAME=Google                     # shown on the button: "Sign in with Google"
SSO_REQUIRE_VERIFIED_EMAIL=true             # Microsoft Entra omits email_verified: set false only if the tenant already restricts who can sign in
BACKUP_INTERVAL_HOURS=24                    # how often the backup service dumps the database
BACKUP_KEEP_DAYS=14                         # dumps older than this are pruned
# Operations (see ops/docker-compose.ops.yml and docs/32-hr-operations-kit.md)
ANTIVIRUS_ENABLED=false                     # true once the clamav service of ops/docker-compose.ops.yml runs; uploads are then refused while it is unreachable
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
CSP_MODE=enforce                            # enforce | report-only (the browser only logs violations; use it to watch a changed policy before enforcing)
